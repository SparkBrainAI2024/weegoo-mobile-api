<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
</head>

<body style="margin:0;padding:20px;background:#f3f4f6;font-family:Arial,Helvetica,sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0">
<tr>
<td align="center">

<table
  width="700"
  cellpadding="0"
  cellspacing="0"
  style="
    background:#ffffff;
    border-radius:8px;
    overflow:hidden;
    border:1px solid #dbeafe;
  "
>

  <!-- HEADER -->
  <tr>
    <td
      style="
        background:#081329;
        padding:35px 40px;
      "
    >

      <table width="100%">
        <tr>

          <td valign="middle">

            <div
              style="
                font-size:52px;
                font-weight:800;
                line-height:1;
                letter-spacing:-2px;
              "
            >
              <span style="color:#FFD21F;">Wee</span><span style="color:#FFFFFF;">G</span><span style="color:#FFD21F;">o</span><span style="color:#FFFFFF;">o</span>
            </div>

            <div
              style="
                margin-top:10px;
                color:#CBD5E1;
                font-size:18px;
              "
            >
              Your Ride. Your Way.
            </div>

          </td>

          <td align="right">

            <!-- Car Icon -->
            <img
              src="{{carIconUrl}}"
              alt="WeeGoo"
              width="120"
              height="100"
              style="display:block;"
            />

          </td>

        </tr>
      </table>

    </td>
  </tr>

  <!-- DYNAMIC CONTENT FROM DATABASE -->
  <tr>
    <td style="padding:40px;">
      {{{content}}}
    </td>
  </tr>

  <!-- FOOTER -->
  <tr>
    <td style="padding:35px 40px;">

      <div style="color:#475569;">
        Regards,
      </div>

      <div
        style="
          margin-top:8px;
          font-size:32px;
          font-weight:700;
          color:#0F172A;
        "
      >
        WeeGoo Team
      </div>

      <div
        style="
          margin-top:6px;
          color:#64748B;
        "
      >
        We're here to get you there.
      </div>

      <div
        style="
          text-align:center;
          margin-top:30px;
        "
      >
        ● ● ● ●
      </div>

      <div
        style="
          text-align:center;
          margin-top:12px;
          color:#64748B;
          font-size:12px;
        "
      >
        © {{currentYear}} WeeGoo. All rights reserved.
      </div>

    </td>
  </tr>

</table>

</td>
</tr>
</table>

</body>
</html>